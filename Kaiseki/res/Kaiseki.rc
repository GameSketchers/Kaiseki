#include <windows.h>

#define IDI_APPICON 101

// Application Icon (First icon is used by Windows Explorer)
1 ICON "Kaiseki.ico"
IDI_APPICON ICON "Kaiseki.ico"

// Manifest resource (RT_MANIFEST = 24)
1 24 "Kaiseki.manifest"

// Embedded Graphics
1001 RCDATA "banner.png"
1002 RCDATA "logo.png"

// Version Information (Standard PE Metadata for Antivirus & Explorer compatibility)
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "anonimbiri\0"
            VALUE "FileDescription",  "Kaiseki - Android APK Reverse Engineering & Security Platform\0"
            VALUE "FileVersion",      "1.0.0-beta\0"
            VALUE "InternalName",     "Kaiseki\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 anonimbiri. All rights reserved.\0"
            VALUE "OriginalFilename", "Kaiseki.exe\0"
            VALUE "ProductName",      "Kaiseki\0"
            VALUE "ProductVersion",   "1.0.0-beta\0"
            VALUE "Comments",         "Modern C++ Native APK Disassembly and Security Analysis Suite\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
